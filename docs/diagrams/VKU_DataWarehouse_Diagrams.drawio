ry" /></mxCell><mxCell id="4" value="&lt;b&gt;dim_giang_vien&lt;/b&gt;&lt;hr/&gt;🔑 giang_vien_key (PK)&lt;br/&gt;• ma_gv (NK)&lt;br/&gt;• ho_ten, hoc_vi&lt;br/&gt;• ten_khoa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="620" y="30" width="190" height="130" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;dim_thoi_gian (Conformed Dim)&lt;/b&gt;&lt;hr/&gt;🔑 date_key (PK, YYYYMMDD)&lt;br/&gt;• full_date&lt;br/&gt;• ngay, thang, nam, quy&lt;br/&gt;• thu_trong_tuan&lt;br/&gt;• hoc_ky_nien_khoa&lt;br/&gt;• ma_hoc_ky" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="930" y="220" width="220" height="180" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;dim_nganh&lt;/b&gt;&lt;hr/&gt;🔑 nganh_key (PK)&lt;br/&gt;• ma_nganh (NK)&lt;br/&gt;• ten_nganh&lt;br/&gt;• ten_khoa, he_dao_tao" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="60" y="560" width="200" height="130" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;dim_tinh_thanh&lt;/b&gt;&lt;hr/&gt;🔑 tinh_thanh_key (PK)&lt;br/&gt;• ten_tinh_thanh&lt;br/&gt;• vung_mien" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="930" y="560" width="200" height="120" as="geometry" /></mxCell><mxCell id="8" value="&lt;b&gt;dim_phuong_thuc_xt&lt;/b&gt;&lt;hr/&gt;🔑 ptxt_key (PK)&lt;br/&gt;• ma_ptxt (NK)&lt;br/&gt;• ten_ptxt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="360" y="750" width="210" height="100" as="geometry" /></mxCell><mxCell id="9" value="&lt;b&gt;fact_ket_qua_hoc_tap (Fact Đào tạo)&lt;/b&gt;&lt;hr/&gt;🔑 fact_id (PK)&lt;br/&gt;🔗 sinh_vien_key (FK)&lt;br/&gt;🔗 hoc_phan_key (FK)&lt;br/&gt;🔗 giang_vien_key (FK)&lt;br/&gt;🔗 date_key (FK)&lt;br/&gt;• ma_lhp&lt;br/&gt;• diem_qua_trinh, diem_thi&lt;br/&gt;• diem_tong_ket, diem_he_4&lt;br/&gt;• diem_chu (A, B, C, D, F)&lt;br/&gt;• ket_qua (Đạt, Rớt), so_tin_chi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="450" y="210" width="320" height="230" as="geometry" /></mxCell><mxCell id="10" value="&lt;b&gt;fact_tuyen_sinh (Fact Tuyển sinh)&lt;/b&gt;&lt;hr/&gt;🔑 tuyen_sinh_key (PK)&lt;br/&gt;🔗 sinh_vien_key (FK)&lt;br/&gt;🔗 nganh_key (FK)&lt;br/&gt;🔗 ptxt_key (FK)&lt;br/&gt;🔗 date_key (FK)&lt;br/&gt;🔗 tinh_thanh_key (FK)&lt;br/&gt;• nam_tuyen_sinh, diem_xet_tuyen&lt;br/&gt;• trang_thai (Trúng tuyển/Không)&lt;br/&gt;• da_nhap_hoc (0/1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="450" y="500" width="320" height="210" as="geometry" /></mxCell><mxCell id="300" value="1 : N (sinh_vien_key)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b71c1c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="2" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="301" value="1 : N (hoc_phan_key)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b71c1c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#333333;labelBackgroundColor=#fffff