ed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="780" y="140" width="200" height="140" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;VIEWS (mvc/views)&lt;/b&gt;&lt;hr/&gt;• Định dạng JSON Response&lt;br/&gt;• Render giao diện HTML&lt;br/&gt;• Trả về trình duyệt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="510" y="360" width="210" height="100" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;DATABASE KHO DỮ LIỆU&lt;/b&gt;&lt;hr/&gt;• MariaDB (edu_dw &amp; edu_source)&lt;br/&gt;• 2 Fact, 6 Dim, OLAP Views&lt;br/&gt;• Stored Procedures SCD2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="780" y="360" width="200" height="100" as="geometry" /></mxCell><mxCell id="500" value="1. Gửi Request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#003366;strokeWidth=1.8;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="501" value="2. Gọi Controller" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#003366;strokeWidth=1.8;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="502" value="3. Yêu cầu dữ liệu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2e7d32;strokeWidth=1.8;endArrow=block;endFill=1;