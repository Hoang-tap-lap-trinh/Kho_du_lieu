<mxfile host="app.diagrams.net" agent="VKU-DataWarehouse" version="21.0.0"><diagram id="tab1" name="Hình 1.1. Kiến trúc Tổng quan KDL"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Layer 1: CSDL Nguồn Tác vụ (OLTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;strokeWidth=2;align=center;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#0288d1;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="240" height="520" as="geometry" /></mxCell><mxCell id="3" value="Layer 2: Tích hợp Dữ liệu &amp; ETL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;strokeWidth=2;align=center;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#f57c00;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="340" y="60" width="300" height="520" as="geometry" /></mxCell><mxCell id="4" value="Layer 3: Kho Dữ liệu Đa chiều (DW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;align=center;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#388e3c;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="700" y="60" width="270" height="520" as="geometry" /></mxCell><mxCell id="5" value="Layer 4: Ứng dụng &amp; Khai thác (BI/OLAP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;align=center;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#7b1fa2;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="1030" y="60" width="230" height="520" as="geometry" /></mxCell><mxCell id="10" value="&lt;b&gt;edu_source (MariaDB 10.4)&lt;/b&gt;&lt;hr/&gt;• Sinh viên &amp; Hồ sơ tuyển sinh&lt;br/&gt;• Điểm đăng ký học phần&lt;br/&gt;• Lớp học phần, Môn học, GV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="60" y="120" width="200" height="90" as="geometry" /></mxCell><mxCell id="11" value="&lt;b&gt;File dữ liệu thô (Raw CSV)&lt;/b&gt;&lt;hr/&gt;• Dữ liệu tuyển sinh 4 năm&lt;br/&gt;• 227.267 bản ghi học tập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="60" y="240" width="200" height="70" as="geometry" /></mxCell><mxCell id="12" value="&lt;b&gt;Chèn lỗi chủ đích&lt;/b&gt;&lt;hr/&gt;• 905 dòng trùng, 905 NULL&lt;br/&gt;• 679 dòng ngoài thang 0-10&lt;br/&gt;• 292 lỗi chính tả tỉnh thành" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="60" y="340" width="200" height="80" as="geometry" /></mxCell><mxCell id="20" value="&lt;b&gt;EXTRACT (Trích xuất)&lt;/b&gt;&lt;hr/&gt;• Đọc từ 11 bảng nguồn OLTP&lt;br/&gt;• Đưa vào tầng Staging bộ nhớ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f57c00;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="360" y="120" width="260" height="70" as="geometry" /></mxCell><mxCell id="21" value="&lt;b&gt;TRANSFORM &amp; DATA QUALITY&lt;/b&gt;&lt;hr/&gt;• Bộ lọc quy tắc điểm [0, 10]&lt;br/&gt;• Xử lý SCD Type 2 (Đổi ngành)&lt;br/&gt;• Chuẩn hóa 18 tỉnh miền Trung&lt;br/&gt;• Tính điểm hệ 4, điểm chữ A-F" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f57c00;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="360" y="220" width="260" height="110" as="geometry" /></mxCell><mxCell id="22" value="&lt;b&gt;Bảng Cách ly (etl_reject)&lt;/b&gt;&lt;hr/&gt;• 2.537 dòng lỗi bị loại bỏ&lt;br/&gt;• Lưu vết nguyên nhân vi phạm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#d32f2f;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="360" y="360" width="260" height="70" as="geometry" /></mxCell><mxCell id="23" value="&lt;b&gt;Nhật ký kiểm toán (etl_log)&lt;/b&gt;&lt;hr/&gt;• Audit Trail, đếm dòng &amp; thời gian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e24aa;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="360" y="460" width="260" height="60" as="geometry" /></mxCell><mxCell id="30" value="&lt;b&gt;Fact Đào tạo &amp; Điểm số&lt;/b&gt;&lt;hr/&gt;• &lt;code&gt;fact_ket_qua_hoc_tap&lt;/code&gt;&lt;br/&gt;• 224.778 dòng sạch (100%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#388e3c;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="720" y="120" width="230" height="80" as="geometry" /></mxCell><mxCell id="31" value="&lt;b&gt;Fact Tuyển sinh&lt;/b&gt;&lt;hr/&gt;• &lt;code&gt;fact_tuyen_sinh&lt;/code&gt;&lt;br/&gt;• 7.964 hồ sơ trúng tuyển" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#388e3c;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="720" y="230" width="230" height="80" as="geometry" /></mxCell><mxCell id="32" value="&lt;b&gt;6 Conformed Dimensions&lt;/b&gt;&lt;hr/&gt;• dim_sinh_vien (SCD2)&lt;br/&gt;• dim_hoc_phan, dim_giang_vien&lt;br/&gt;• dim_thoi_gian, dim_nganh&lt;br/&gt;• dim_tinh_thanh, dim_ptxt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#388e3c;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="720" y="340" width="230" height="120" as="geometry" /></mxCell><mxCell id="40" value="&lt;b&gt;Web Dashboard MVC&lt;/b&gt;&lt;hr/&gt;• Cổng 8050 tương tác&lt;br/&gt;• 6 Bi