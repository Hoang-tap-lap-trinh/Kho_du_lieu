ed=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e65100;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="5" target="10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="308" value="1 : N (tinh_thanh_key)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e65100;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="7" target="10"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="tab4" name="Hình 4.1 &amp; 4.2. Quy trình ETL"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="&lt;b&gt;edu_source (OLTP 3NF)&lt;/b&gt;&lt;hr/&gt;• 11 Bảng tác vụ&lt;br/&gt;• 227.267 bản ghi thô&lt;br/&gt;• Chứa lỗi chủ đích" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="40" y="160" width="160" height="90" as="geometry" /></mxCell><mxCell id="3" value="&lt;b&gt;1. EXTRACT&lt;/b&gt;&lt;hr/&gt;• Trích xuất theo lô&lt;br/&gt;• &lt;code&gt;extract.py&lt;/code&gt;&lt;br/&gt;• Nạp vào tầng Staging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="250" y="160" width="150" height="90" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;2. TRANSFORM &amp; CLEANSE&lt;/b&gt;&lt;hr/&gt;• &lt;code&gt;transform.py&lt;/code&gt;&lt;br/&gt;• Kiểm tra miền [0, 10]&lt;br/&gt;• Lọc trùng lặp Grain&lt;br/&gt;• Chuẩn hóa 18 Tỉnh/thành&lt;br/&gt;• Tính điểm hệ 4, chữ A-F&lt;br/&gt;• Xử lý SCD Type 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="460" y="130" width="220" height="150" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;Bảng Cách ly (etl_reject)&lt;/b&gt;&lt;hr/&gt;• 2.537 dòng lỗi vi phạm&lt;br/&gt;• Ghi nhận nguyên nhân&lt;br/&gt;• Không làm dừng hệ thống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="460" y="360" width="220" height="100" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;Nhật ký Kiểm toán (etl_log)&lt;/b&gt;&lt;hr/&gt;• Ghi số dòng In/Out/Reject&lt;br/&gt;• Thời gian chạy pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="460" y="20" width="220" height="80" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;3. LOAD&lt;/b&gt;&lt;hr/&gt;• &lt;code&gt;load.py&lt;/code&gt;&lt;br/&gt;• Nạp Dim trước (SCD2)&lt;br/&gt;• Nạp Fact sau (Bulk 1K)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="740" y="160" width="160" height="90" as="geometry" /></mxCell><mxCell id="8" value="&lt;b&gt;Kho Dữ liệu (edu_dw)&lt;/b&gt;&lt;hr/&gt;• fact_ket_qua_hoc_tap (224K)&lt;br/&gt;• fact_tuyen_sinh (7.9K)&lt;br/&gt;• 6 Bảng Dimension sạch&lt;br/&gt;• Đạt 10/10 Test Cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1"><mxGeometry x="960" y="140" width="200" height="130" as="geometry" /></mxCell><mx